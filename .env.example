# DeepInfra API key, used for embedding generation.
DEEPINFRA_API_KEY=

# Google Gemini API key, used for LLM calls (mining / analysis passes).
GEMINI_API_KEY=

# Alternate name accepted for the same Google Gemini API key.
GOOGLE_API_KEY=

# Absolute path to the warehouse SQLite database file.
MATRIX_OPS_DB=

# Absolute path to a trusted root directory used to validate file-based inputs.
MATRIX_OPS_TRUSTED_ROOT=

# Absolute path to a local ClaudeClaw installation, used as a read-only source.
CLAUDECLAW_DIR=

# LAN address the fleet board advertises (default: first RFC 1918 IPv4 on this host)
MATRIX_LAN_HOST=
